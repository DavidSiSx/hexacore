generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp"), vector]
}

/// Representa tanto Pokémon oficiales como Fakemons creados por la comunidad.
/// Utiliza un modelo híbrido: metadatos relacionales para ordenamiento y JSONB para atributos dinámicos.
model Criatura {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre               String     @unique
  slug                 String     @unique
  autor                String?    @default("oficial")
  es_fakemon           Boolean    @default(false)
  popularidad_score    Float      @default(0.0)
  aprobado_comunidad   Boolean    @default(true)
  atributos_de_combate Json
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt
  categorias           Json?
  descripciones        Json?
  nombres              Json?
  base_species_id      String?    @db.Uuid
  base_species         Criatura?  @relation("FormInheritance", fields: [base_species_id], references: [id])
  forms                Criatura[] @relation("FormInheritance")

  @@index([atributos_de_combate(ops: JsonbPathOps)], map: "idx_criatura_atributos_gin", type: Gin)
  @@index([popularidad_score(sort: Desc)])
}

/// Almacena el conocimiento semántico del metajuego, incluyendo reportes de torneos (chunks) y reflexiones autónomas.
model DocumentoConocimiento {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type   String
  contenido  String
  metadatos  Json
  embedding  Unsupported("vector")?
  created_at DateTime               @default(now())

  @@index([embedding])
}

/// Sustrato de Inteligencia de Trazas: Registra la "Verdad Terrestre" cuando un usuario corrige a la IA.
model TrazaCorreccion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id          String
  prompt_original     String
  contexto_rag_usado  Json
  equipo_sugerido     Json
  equipo_corregido    Json
  procesado_por_motor Boolean  @default(false)
  created_at          DateTime @default(now())

  @@index([procesado_por_motor])
}

/// Representa un Objeto equipable en el juego (Ej: Leftovers, Choice Band)
model Objeto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String   @unique
  slug          String   @unique
  sprite_url    String?
  atributos     Json?
  created_at    DateTime @default(now())
  descripciones Json?
  nombres       Json?
}

/// Representa una Habilidad de un Pokémon (Ej: Intimidate, Levitate)
model Habilidad {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String   @unique
  slug          String   @unique
  atributos     Json?
  created_at    DateTime @default(now())
  descripciones Json?
  nombres       Json?
}

/// Representa un Movimiento (Ej: Earthquake, Protect)
model Movimiento {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String   @unique
  slug          String   @unique
  tipo          String
  categoria     String
  potencia      Int
  precision     Int
  atributos     Json?
  created_at    DateTime @default(now())
  descripciones Json?
  nombres       Json?
}

/// Representa un Formato o Ruleset del Metajuego (Ej: VGC 2024 Reg G, OU Gen 9)
model Formato {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @unique
  descripcion String
  reglas      Json
  created_at  DateTime @default(now())
}

/// Usuario autenticado vía Supabase Auth.
/// El `id` coincide con el `auth.uid()` de Supabase para habilitar RLS.
model Usuario {
  id         String   @id @db.Uuid
  email      String   @unique
  nombre     String
  avatar_url String?
  created_at DateTime @default(now())
  equipos    Equipo[]
}

/// Un equipo competitivo guardado por el usuario.
model Equipo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre     String
  formato    String
  miembros   Json
  estrategia String?
  origen     String   @default("manual")
  pokepaste  String?
  usuarioId  String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}
