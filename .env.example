# Environment variables (copy this file to .env and fill in your values)

# Connect to Supabase via connection pooling (used at runtime)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-X-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database (used for migrations and seed)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-X-us-west-2.pooler.supabase.com:5432/postgres"

# Google Gemini API Key (required for AI features)
GEMINI_API_KEY="your_gemini_api_key_here"
